{
  "name": "dockcodes/dock-ray",
  "type": "library",
  "description": "PHP SDK for DockRay — application error and performance monitoring (https://dock.codes)",
  "keywords": [
    "logging",
    "error-monitoring",
    "error-handler",
    "crash-reporting",
    "performance-monitoring"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Jacek Sultan",
      "email": "j.sultan@dock.codes",
      "homepage": "https://dock.codes"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/promises": "^1.0|^2.0",
    "jean85/pretty-package-versions": "^2.0.4",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "php-http/client-common": "^2.7",
    "php-http/discovery": "^1.19",
    "php-http/httplug": "^2.4",
    "psr/http-factory": "^1.0",
    "psr/log": "^1.0|^2.0|^3.0",
    "symfony/http-client": "^4.4|^5.4|^6.0|^7.0",
    "symfony/options-resolver": "^4.4|^5.4|^6.0|^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.40",
    "monolog/monolog": "^1.3|^2.0|^3.0",
    "php-http/mock-client": "^1.6",
    "phpstan/phpstan": "^1.10|^2.0",
    "phpunit/phpunit": "^9.6|^10.0|^11.0"
  },
  "suggest": {
    "ext-zlib": "Compresses the request body before it is sent (enabled by default)",
    "monolog/monolog": "Reports records written to a Monolog channel",
    "php-http/guzzle7-adapter": "Delivers events through Guzzle instead of the Symfony HTTP client"
  },
  "autoload": {
    "files": [
      "src/functions.php"
    ],
    "psr-4": {
      "Dock\\Ray\\": "src/"
    }
  },
  "conflict": {
    "php-http/client-common": "1.8.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
